# Connection string from your Supabase project (Settings → Database → Connection string).
# Use the "URI" form, then prefix the scheme with "+psycopg".
#
#   Supabase gives you:        postgresql://postgres:<pwd>@db.<ref>.supabase.co:5432/postgres
#   Put this here as:    postgresql+psycopg://postgres:<pwd>@db.<ref>.supabase.co:5432/postgres?sslmode=require
#
# For day-to-day app traffic you can use the pooled connection on port 6543; for
# `alembic upgrade head` always use the direct connection on port 5432.
DATABASE_URL=postgresql+psycopg://postgres:CHANGEME@db.CHANGEME.supabase.co:5432/postgres?sslmode=require

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# NASA FIRMS — free satellite-fire detection API.
# Get a key at https://firms.modaps.eosdis.nasa.gov/api/map_key/
# (email-based, arrives in seconds). Required for `make ingest-firms`.
NASA_FIRMS_MAP_KEY=
